// libghostty-vt for sg_terminal, fetched by Zig's package manager into its
// global cache (once per machine, shared by every worktree and target dir).
// `.cargo/config.toml` points GHOSTTY_SOURCE_DIR here, so the
// libghostty-vt-sys build script runs `zig build` in this directory.
//
// The release must be the one the libghostty-vt bindings pin (their build.rs
// GHOSTTY_COMMIT is the vt-X.Y.Z tag): bump both together. New hash:
// `zig fetch <url>`.
.{
    .name = .sg_terminal_ghostty,
    .version = "0.0.0",
    .fingerprint = 0xf5d198c1c7221eda,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        .ghostty = .{
            // The signed libghostty-vt source release (4.5 MB).
            .url = "https://release.files.ghostty.org/libghostty-vt/1.0.1/libghostty-vt-1.0.1.tar.gz",
            .hash = "ghostty-1.4.1-dev-5UdBC7mPUgFIzAVXNJOixiryPYogwYwnmN0zZWud4iSr",
        },
    },
    .paths = .{ "build.zig", "build.zig.zon" },
}
